# ---------------------------------------------------------------------------
# Mirhollio Core — website build configuration
#
# This repository is the PUBLIC WEBSITE ONLY. It reads public Flare chain state
# and public ecosystem APIs and writes JSON snapshots into data/.
#
# It therefore has NO credentials of any kind, and none may ever be added:
#
#   * No private keys, mnemonics, keystores or any other signing material.
#   * No API keys, tokens or passwords.
#   * No validator, node or price-provider host names, paths or endpoints.
#
# The Mirhollio FTSO price-provider implementation is a separate, private
# project. Its source, algorithms, models, credentials and infrastructure must
# never be moved, copied, referenced or documented here.
#
# Everything below is non-secret tuning. Every value is optional and every
# default is a public endpoint. Copy this file to .env for local runs — .env is
# git-ignored and must stay that way.
#
# Anything a browser can read is public by definition. Never put a value here
# that you would not publish: the frontend is static HTML/CSS/JS with no build
# step, so nothing is ever "compiled out" of a bundle.
# ---------------------------------------------------------------------------

# --- Flare JSON-RPC ---------------------------------------------------------
# Comma-separated public RPC endpoints, tried in order. Defaults to the public
# Flare endpoints already named in scripts/lib/flare-rpc.mjs.
# Use public infrastructure only. A private or authenticated RPC URL belongs in
# your shell or your CI secret store, never in this file or this repository.
FLARE_RPC_URLS=https://flare-api.flare.network/ext/C/rpc

# Endpoints used for the heavier eth_getLogs scans, if they differ.
FLARE_LOG_RPC_URLS=https://flare-api.flare.network/ext/C/rpc

# Public block explorer API used for delegation log discovery.
FLARE_EXPLORER_URL=https://flare-explorer.flare.network/api

# --- Timeouts (milliseconds) ------------------------------------------------
FLARE_RPC_TIMEOUT_MS=15000
FLARE_BASE_TIMEOUT_MS=20000
ORACLE_TIMEOUT_MS=30000

# --- Delegator discovery tuning ---------------------------------------------
DELEGATION_DISCOVERY_BUDGET_MS=60000
DELEGATION_EXPLORER_WINDOW=2000000
DELEGATION_FIRST_LOOKBACK=200000
DELEGATION_HISTORY_MARGIN_DAYS=2
DELEGATION_MIN_AMOUNT=1

# --- Publisher loop cadence (scripts/publish-watch-status-loop.sh) ----------
REFRESH_INTERVAL_SECONDS=300
REFRESH_WINDOW_SECONDS=3900
DELEGATION_EVERY_CYCLES=3
POSITION_EVERY_CYCLES=3
